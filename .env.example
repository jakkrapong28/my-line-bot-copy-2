# ── ENEOS AI v5.3 — environment template ──
# Copy to .env and fill in real values. Do NOT commit .env.

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Groq LLM
GROQ_API_KEY=

# Admin auth (use long random strings in production)
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Redis (in Docker Compose this is overridden to redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0
# Generated vector/BM25/model data; Docker Compose overrides this to /app/data.
DATA_DIR=.

# Optional
DEBUG=false
FORCE_REBUILD_DB=false
# JSON array; use the real frontend origin(s) instead of "*" in production.
# CORS_ORIGINS=["https://example.com"]
